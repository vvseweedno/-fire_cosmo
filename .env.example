# Environment variables for Wildfire Nexus Core (Hackathon Edition)

# App Configuration
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Offline Mode (default for hackathon demo without API keys)
OFFLINE_MODE=true

# Data Directories
DATA_DIR=./data
CACHE_DIR=./data/cache
OUTPUT_DIR=./data/outputs

# NASA FIRMS MAP_KEY (get free key at https://firms.modaps.eosdis.nasa.gov/api/)
FIRMS_MAP_KEY=your_firms_map_key_here

# Earthdata / STAC Configuration
EARTHDATA_TOKEN=
SENTINEL2_STAC_API=https://earth-search.aws.element84.com/v1

# Optional JSON array of known industrial hotspots:
# [{"lat": 56.0, "lon": 92.0, "radius_km": 2.0}]
# Leave empty unless the list is sourced/validated for your region.
INDUSTRIAL_WHITELIST_PATH=

# Detection Thresholds
DEFAULT_MIN_CONFIDENCE=nominal
MAX_CLOUD_COVER=20
PRE_IMAGE_DAYS_BEFORE=90
POST_IMAGE_DAYS_AFTER=30
MIN_FIRE_POINT_CLUSTER_SIZE=2

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/wildfire.db

# Telegram Bot Configuration (optional - legacy)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
